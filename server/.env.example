# Copy to server/.env and fill in. Never commit .env (spec §6.3).
DATABASE_URL=postgresql://...
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_POOL_ACCOUNT_ID=
SERVER_SIGNING_KEY_PEM=
FACTORY_API_KEY=
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=
CHALK_DISABLED=0
PHOTON_API_KEY=
PUBLIC_BASE_URL=https://<cloudflared>.trycloudflare.com
NWS_USER_AGENT=StormCash HackHarvard demo (team email)
DEMO_MODE=1
NESSIE_DISABLED=0
API_SIG_REQUIRED=1
# StormDesk: droid | fake | auto (auto = Droid only with FACTORY_API_KEY; droid also works with a logged-in CLI).
# Droid runs cost Factory credits: with STORMDESK_RUNNER=droid, STORMDESK_AUTO=0 stops the worker running every new case.
STORMDESK_RUNNER=auto
STORMDESK_MODEL=claude-sonnet-5-5
STORMDESK_AUTO=1
